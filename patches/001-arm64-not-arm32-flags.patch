From: Andrei Gosman <andrei.gosman@gmail.com>
Date: 2026-09-03
Subject: [PATCH 001/NNN] build: do not apply 32-bit ARM flags on 64-bit ARM

CMAKE_SYSTEM_PROCESSOR is "arm64" on Darwin and "aarch64" on Linux. The
guard around -mfloat-abi=hard -mfpu=neon tests MATCHES "arm", which is a
substring match, so it is true for "arm64" and false for "aarch64". On
macOS ARM64 the build therefore passes two 32-bit ARM options to a
compiler that rejects them:

  clang++: error: unsupported option '-mfloat-abi=' for target
           'arm64-apple-darwin25.5.0'
  clang++: error: unsupported option '-mfpu=' for target
           'arm64-apple-darwin25.5.0'

The same substring asymmetry has a second effect. HAVE_NEONv8 is set only
when the processor string matches "aarch64", so a Darwin ARM64 build gets
HAVE_NEON without HAVE_NEONv8 and silently selects the 32-bit NEON code
paths in lib/src/phy/modem/demod_soft.c and lib/src/common/arch_select.cc.
Apple Silicon is ARMv8; it should take the same path as Linux aarch64.

Both are fixed by naming the 64-bit processor strings explicitly rather
than relying on a substring match. This is not Darwin-specific: any
platform that reports arm64 was affected the same way.

--- a/CMakeLists.txt	2026-09-03 14:17:54
+++ b/CMakeLists.txt	2026-09-03 14:17:54
@@ -461,15 +461,22 @@
     set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -DIS_ARM")
     message(STATUS "Detected ARM processor")
     set(HAVE_NEON "True")
-    if(${CMAKE_SYSTEM_PROCESSOR} MATCHES "aarch64")
+    # Darwin reports arm64 where Linux reports aarch64. Both are 64-bit ARM
+    # and both have NEONv8; only the processor string differs.
+    if(${CMAKE_SYSTEM_PROCESSOR} MATCHES "aarch64" OR ${CMAKE_SYSTEM_PROCESSOR} MATCHES "arm64")
       set(HAVE_NEONv8 "True")
       set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -DHAVE_NEONv8")
       set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -DHAVE_NEONv8")
-    endif(${CMAKE_SYSTEM_PROCESSOR} MATCHES "aarch64")
-    if(${CMAKE_SYSTEM_PROCESSOR} MATCHES "arm")
+    endif(${CMAKE_SYSTEM_PROCESSOR} MATCHES "aarch64" OR ${CMAKE_SYSTEM_PROCESSOR} MATCHES "arm64")
+    # -mfloat-abi and -mfpu are 32-bit ARM options. MATCHES "arm" also matches
+    # the string arm64, so on 64-bit ARM they were being added to a compiler
+    # that rejects them. Exclude the 64-bit processor strings.
+    if(${CMAKE_SYSTEM_PROCESSOR} MATCHES "arm"
+       AND NOT ${CMAKE_SYSTEM_PROCESSOR} MATCHES "arm64"
+       AND NOT ${CMAKE_SYSTEM_PROCESSOR} MATCHES "aarch64")
       set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -mfloat-abi=hard -mfpu=neon")
       set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -mfloat-abi=hard -mfpu=neon")
-    endif(${CMAKE_SYSTEM_PROCESSOR} MATCHES "arm")
+    endif()
   else(${CMAKE_SYSTEM_PROCESSOR} MATCHES "arm" OR ${CMAKE_SYSTEM_PROCESSOR} MATCHES "aarch" OR ${CMAKE_SYSTEM_PROCESSOR} MATCHES "aarch64")
     set(HAVE_NEON "False")
   endif(${CMAKE_SYSTEM_PROCESSOR} MATCHES "arm" OR ${CMAKE_SYSTEM_PROCESSOR} MATCHES "aarch" OR ${CMAKE_SYSTEM_PROCESSOR} MATCHES "aarch64")
